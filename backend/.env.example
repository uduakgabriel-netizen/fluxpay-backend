# ==============================================================================
# FluxPay Backend — Environment Variables Template (.env.example)
# ==============================================================================

# ─── 1. Server & Environment ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
LOG_LEVEL="info"

# ─── 2. Database (PostgreSQL + Prisma) ─────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/fluxpay?schema=public"

# ─── 3. Authentication & Security (JWT & AES-256) ─────────────────────────────
JWT_SECRET="generate-a-secure-random-64-character-jwt-secret-key-here"
JWT_EXPIRES_IN="7d"
# 32 bytes in hex = 64 hex characters (e.g., node -e "console.log(crypto.randomBytes(32).toString('hex'))")
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ADMIN_SECRET="your-admin-secret-key-for-internal-operations"
ADMIN_EMAIL="admin@fluxpay.io"

# ─── 4. Solana Network & RPC Nodes ────────────────────────────────────────────
# "devnet" or "mainnet-beta"
SOLANA_NETWORK="devnet"
# Multi-RPC failover configuration:
SOLANA_RPC_PRIMARY="https://api.devnet.solana.com"
SOLANA_RPC_SECONDARY="https://api.devnet.solana.com"
SOLANA_RPC_FALLBACK="https://api.devnet.solana.com"
SOLANA_RPC_DEVNET="https://api.devnet.solana.com"
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# ─── 5. Gas / Escrow Wallets (Non-Custodial Fee Sponsor) ──────────────────────
# Private key can be Base58, Hex, Base64, or JSON array format.
FLUXPAY_WALLET_PUBLIC_KEY="your-gas-wallet-public-key-base58"
FLUXPAY_WALLET_PRIVATE_KEY="your-gas-wallet-private-key"
FLUXPAY_ESCROW_WALLET_PUBLIC_KEY="your-escrow-wallet-public-key-base58"
FLUXPAY_ESCROW_WALLET_PRIVATE_KEY_BASE64="your-escrow-wallet-private-key-base64"

# ─── 6. Jupiter DEX Aggregator ────────────────────────────────────────────────
JUPITER_API_URL="https://quote-api.jup.ag/v6"
JUPITER_TOKEN_API_URL="https://token.jup.ag/all"
JUPITER_API_KEY=""

# ─── 7. Helius (Solana Real-Time Webhooks & Transaction Parser) ───────────────
HELIUS_API_KEY="your-helius-api-key"
HELIUS_WEBHOOK_SECRET="your-helius-webhook-hmac-secret"

# ─── 8. Fiat Settlement Rails (Monnify & OneLiquidity) ────────────────────────
USE_MOCK_PROVIDERS="false"

# Monnify (Bank Account Verification & NGN Disbursements)
MONNIFY_API_KEY="MK_TEST_your-monnify-api-key"
MONNIFY_SECRET_KEY="your-monnify-secret-key"
MONNIFY_BASE_URL="https://sandbox.monnify.com"
MONNIFY_CONTRACT_CODE="your-monnify-contract-code"

# OneLiquidity (Crypto → Fiat On/Off-Ramp)
ONELIQUIDITY_API_KEY="your-oneliquidity-api-key"
ONELIQUIDITY_BASE_URL="https://sandbox-api.oneliquidity.technology"
ONELIQUIDITY_WEBHOOK_SECRET="your-oneliquidity-webhook-secret"
NGN_WEBHOOK_SECRET="your-ngn-webhook-secret"
USDEUR_WEBHOOK_SECRET="your-usdeur-webhook-secret"

# ─── 9. Queue & Background Workers (Redis / BullMQ) ───────────────────────────
# If left empty, fallback memory queue is utilized
REDIS_URL="redis://127.0.0.1:6379"

# ─── 10. Webhooks & Retries ───────────────────────────────────────────────────
WEBHOOK_TIMEOUT_MS=10000
FLUXPAY_WEBHOOK_SECRET="whsec_your-default-fluxpay-webhook-secret"

# ─── 11. Alerts & Notifications ───────────────────────────────────────────────
# Resend Email (Merchant transaction receipts and onboarding)
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="noreply@fluxpay.io"

# Discord Webhook Monitoring
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your-channel/your-webhook-token"
ALERT_SWAP_FAILURE_THRESHOLD=5
ALERT_WALLET_BALANCE_THRESHOLD=0.1

# ─── 12. Settlement & Checkout Policies ───────────────────────────────────────
MIN_SETTLEMENT_AMOUNT=10
SETTLEMENT_FEE_RATE=0.005
REFUND_WINDOW_DAYS=30
FLUXPAY_CHECKOUT_URL="https://fluxpay.io/pay"
